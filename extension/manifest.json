{
  "manifest_version": 3,
  "name": "OverPage",
  "version": "0.2.0",
  "description": "Analyze and chat with any webpage using AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
